{
  "name": "beyond-the-bend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node tools/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "car": "blender -b --python tools/blender/build_car.py -- public/models/car.glb",
    "shots": "node tools/shoot.mjs",
    "test:camera": "node tools/camera-test.mjs",
    "test:comfort": "node tools/run-comfort.mjs",
    "test:handling": "node tools/run-handling.mjs",
    "test:mobile": "node tools/mobile-browser-check.mjs",
    "test:drive": "node tools/hud-check.mjs && node tools/session-clock-check.mjs",
    "test:stability": "node tools/stability.mjs",
    "package:desktop": "npm run build && node tools/desktop/package.mjs",
    "test:journey": "node tools/journey-check.mjs",
    "test:slice": "node tools/slice-world.mjs && node tools/slice-handling.mjs",
    "shots:slice": "node tools/slice-shoot.mjs",
    "shots:looks": "node tools/slice-looks.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
